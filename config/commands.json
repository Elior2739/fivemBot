{
    "status": {
        "type": "embed",
        "responesEphemeral": true,
        
        "permission": {
            "type": "permission",
            "value": "SendMessages",

            "ignoreAdministrator": false
        },

        "embedStates": {

            "base": {
                "title":"%serverName% - Server Status"
            },

            "online": {
                "title": "%serverName% - Server Status",
                "description": "The server is currently **Online**, to join click [here](%serverCfxAddress%)\nThere are %currentPlayers%/%maxPlayers% players currently.",
                "color": 65280
            },

            "offline": {
                "title": "%serverName% - Server Status",
                "description": "the server is currently **Offline**",
                "color": 16711680
            }
        }
    },

    "suggest": {
        "type": "embed",
        "responesEphemeral": true,

        "permission": {
            "type": "role",
            "value": "1103594726290116679",

            "ignoreAdministrator": false
        },

        "modal": {
            "modalTitle": "Suggest a suggestion",
            "modalInputLabel": "What is the suggestion?"
        },

        "buttons": {
            "upvote": {
                "text": "Upvote",
                "style": 3
            },

            "downvote": {
                "text": "Downvote",
                "style": 4
            }
        },

        "embedStates": {
            "tooLong": {
                "title": "Error!",
                "description": "The suggestion text is too long!"
            },

            "channelNotFound": {
                "title": "Error!",
                "description": "Suggestion channel not found, Please try again later\n"
            },

            "suggestion": {
                "title": "New Suggestion!",
                "color": 16711680,
                "fields": [
                    {
                        "name": "Member",
                        "value": "%userTag% (%memberName%)",
                        "inline": false
                    },
                    {
                        "name": "Suggestion",
                        "value": "%suggestionText%",
                        "inline": true
                    },
                    {
                        "name": "Votes",
                        "value": "%upvotes% Upvotes || %downvotes% Downvotes",
                        "inline": true
                    }
                ],
                "footer": {
                    "text": "Suggestion ID: %suggestionId%"
                }
            }
        }
    }
}